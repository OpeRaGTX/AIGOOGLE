# Studio: only briefs, notes and code go to git. Materials, intermediates and renders stay on this PC.
node_modules/
projects/*/inbox/
projects/*/work/
projects/*/public/
projects/*/out/
__pycache__/
# third-party tools fetched locally (see tools/anim/vendor/install_momask.sh, tools/addons/fetch_addons.sh)
tools/anim/vendor/*
!tools/anim/vendor/install_momask.sh
tools/addons/*
!tools/addons/fetch_addons.sh
