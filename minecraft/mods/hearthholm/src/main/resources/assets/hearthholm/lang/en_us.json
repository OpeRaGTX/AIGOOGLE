 "bubble.hearthholm.idle.9": "What a nice little town.",
 "bubble.hearthholm.chat.0": "Remember last harvest?",
 "bubble.hearthholm.chat.1": "How is your family?",
 "bubble.hearthholm.chat.2": "You always make me laugh.",
 "bubble.hearthholm.chat.3": "Let us sit by the fire.",
 "bubble.hearthholm.chat.4": "Did you hear the news?",
 "bubble.hearthholm.chat.5": "I am glad we are friends.",
 "bubble.hearthholm.chat.6": "Tomorrow will be a good day.",
 "bubble.hearthholm.chat.7": "Tell me another story!",
