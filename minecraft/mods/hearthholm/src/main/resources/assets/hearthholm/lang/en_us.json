 "bubble.hearthholm.greet.0": "Good day, %2$s!",
 "bubble.hearthholm.greet.1": "Welcome back, %2$s.",
 "bubble.hearthholm.greet.2": "%2$s! Look how %1$s grows!",
 "bubble.hearthholm.greet.3": "Hello, boss!",
 "bubble.hearthholm.greet.4": "Everything is in order, %2$s.",
 "bubble.hearthholm.greet.5": "Nice to see you!",
 "bubble.hearthholm.greet.6": "%1$s is lucky to have you.",
 "bubble.hearthholm.greet.7": "Need anything, %2$s?",
 "bubble.hearthholm.hungry.0": "My stomach is growling...",
 "bubble.hearthholm.hungry.1": "Is there any bread left?",
 "bubble.hearthholm.hungry.2": "I could eat a whole pie.",
 "bubble.hearthholm.hungry.3": "Hungry. So hungry.",
 "bubble.hearthholm.hungry.4": "When is lunch?",
 "bubble.hearthholm.hungry.5": "Food... I need food.",
 "bubble.hearthholm.hungry.6": "The warehouse had bread, right?",
 "bubble.hearthholm.no_bed.0": "I still have no bed...",
 "bubble.hearthholm.no_bed.1": "Sleeping on the floor again.",
 "bubble.hearthholm.no_bed.2": "Is there a free bed anywhere?",
 "bubble.hearthholm.no_bed.3": "A bed would be nice.",
 "bubble.hearthholm.no_bed.4": "My back hurts from the floor.",
 "bubble.hearthholm.no_bed.5": "Build more houses, please!",
 "bubble.hearthholm.no_bed.6": "%1$s needs more beds.",
 "bubble.hearthholm.night.0": "It is getting late.",
